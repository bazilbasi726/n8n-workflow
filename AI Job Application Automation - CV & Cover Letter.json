      "id": "a2f39770-b8e0-486f-8298-8da193438b63",
      "name": "Filter Jobs with AI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        848,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Parse OpenAI JSON response and filter\nconst items = [];\n\nfor (const item of $input.all()) {\n  try {\n    let response = item.json.text || item.json.message?.content || item.json;\n    \n    // Extract JSON if wrapped in markdown code blocks\n    if (typeof response === 'string') {\n      const jsonMatch = response.match(/```json\\s*([\\s\\S]*?)```/) || response.match(/\\[\\s*{[\\s\\S]*}\\s*\\]/);\n      if (jsonMatch) {\n        response = jsonMatch[1] || jsonMatch[0];\n      }\n      response = JSON.parse(response);\n    }\n    \n    // Handle both array and single object responses\n    const jobs = Array.isArray(response) ? response : [response];\n    \n    for (const job of jobs) {\n      // Get minimum score threshold\n      const minScore = $('Set: CV Text & Config').item.json.min_relevance_score || 0.7;\n      \n      if (job.passed === true && job.score >= minScore) {\n        // Merge with original job data\n        const originalJob = $('Scrape LinkedIn Jobs').all().find(j => \n          j.json.id === job.jobId || j.json.title === job.title\n        );\n        \n        items.push({\n          json: {\n            ...originalJob?.json,\n            ...job,\n            ai_filtered: true,\n            filtered_at: new Date().toISOString()\n          }\n        });\n      }\n    }\n  } catch (error) {\n    console.error('Error parsing AI response:', error);\n    continue;\n  }\n}\n\nreturn items;"
      },
